{
    // esbuild and tsc resolve files reached through the host's src/userplugins symlink by their real
    // path, so Vencord's path aliases (@api/*, @utils/*, ...) must come from here. Extend the combined
    // build tree directly: a symlink to it inside this repo would loop (vencord/src/userplugins/vcShrink
    // -> here -> vencord) and send stylelint's glob into endless recursion. To build in another Vencord
    // tree, change this path.
    "extends": "../vencord/tsconfig.json"
}
